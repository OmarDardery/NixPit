{
  "containers": {
    "klipper": {
      "image": "docker.io/mkuf/klipper:latest",
      "volumes": [
        "/dev:/dev",
        "/var/lib/printer_data/config:/opt/printer_data/config",
        "/var/lib/printer_data/run:/opt/printer_data/run",
        "/var/lib/printer_data/gcodes:/opt/printer_data/gcodes"
      ],
      "usbPassthrough": [
        "/dev/serial/by-id/usb-Klipper_stm32-if00"
      ],
      "extraOptions": [
        "--privileged"
      ]
    },
    "moonraker": {
      "image": "docker.io/mkuf/moonraker:latest",
      "ports": [
        "7125:7125"
      ],
      "network": "printer-net",
      "volumes": [
        "/var/lib/printer_data/config:/opt/printer_data/config",
        "/var/lib/printer_data/run:/opt/printer_data/run",
        "/var/lib/printer_data/gcodes:/opt/printer_data/gcodes"
      ],
      "dependsOn": [
        "klipper"
      ]
    },
    "mainsail": {
      "image": "ghcr.io/mainsail-crew/mainsail:latest",
      "ports": [
        "8080:80"
      ],
      "network": "printer-net",
      "domain": "printer.home.arpa",
      "dependsOn": [
        "moonraker"
      ]
    },
    "aiostreams": {
      "image": "ghcr.io/viren070/aiostreams:latest",
      "ports": [
        "127.0.0.1:3000:3000"
      ],
      "volumes": [
        "/var/lib/aiostreams:/app/data"
      ],
      "secretName": "aiostreams",
      "extraOptions": [
        "--pull=always"
      ]
    },
    "cloudflared": {
      "image": "docker.io/cloudflare/cloudflared:latest",
      "cmd": [
        "tunnel",
        "--no-autoupdate",
        "run"
      ],
      "secretName": "cloudflared",
      "extraOptions": [
        "--network=host"
      ],
      "dependsOn": [
        "aiostreams"
      ]
    }
  },
  "vms": {
    "iot-gateway": {
      "uuid": "cc7439ed-36af-4696-a6f2-1f0c4474d87e",
      "vcpus": 2,
      "memoryGiB": 2,
      "disk": "debian-13.qcow2",
      "network": "default",
      "usbPassthrough": [
        "0bda:8812"
      ],
      "active": true
    }
  }
}
